# Azure OpenAI / Foundry: one key + one project URL covers every deployment.
LLM_PROVIDER=azure
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

AZURE_OPENAI_API_KEY=
# Foundry project URL, resource root, or .../openai/v1/ — all are accepted.
# Example: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_OPENAI_ENDPOINT=
# Aliases: AZURE_OPENAI_PROJECT_URL=  FOUNDRY_PROJECT_ENDPOINT=

# Optional: different deployments per agent (same key + URL). Unset = LLM_MODEL.
# LLM_MODEL_PROBLEM_INNOVATION=gpt-4o
# LLM_MODEL_TECHNICAL=gpt-4.1
# LLM_MODEL_IMPACT_PRESENTATION=gpt-4o-mini
# LLM_MODEL_FINAL=gpt-4.1

# Other providers (optional)
# LLM_PROVIDER=openai | anthropic | google | ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: enable evaluation from public Google Drive folders (Drive API enabled in Google Cloud)
GOOGLE_DRIVE_API_KEY=

# Optional: FalkorDB graph store (submissions, scores, evidence and insights as a graph).
# Leave empty to disable. Examples: falkor://localhost:6379  |  falkor://user:pass@host:6379  |  falkors://... (TLS)
FALKORDB_URL=
FALKORDB_GRAPH=hackeval

# Limits
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=2
MAX_DOC_CHARS=40000
MAX_ZIP_MB=200
MAX_UNCOMPRESSED_MB=500
MAX_FILES=100

# Paths / URLs
DATA_DIR=./data
CSV_PATH=./data/evaluation.csv
API_URL=http://127.0.0.1:8000
